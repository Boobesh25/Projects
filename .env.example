# JobRadar Enterprise Platform Configuration
# ==========================================

# Database Connection (PostgreSQL with asyncpg; falls back to SQLite if unreachable)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/career_portal

# Backend API Service URL (For frontend to reach backend)
# In standalone/local: http://localhost:8000
# In Docker compose: http://api:8000
API_BASE_URL=http://localhost:8000

# Security & Authentication
JWT_SECRET=jobradar-enterprise-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Authorized Enterprise Account
DEFAULT_USER_EMAIL=boobesh2509@gmail.com

# AI Engine (Optional: Google Gemini API Key for Gemini 2.0 Flash)
GEMINI_API_KEY=

# Ports
PORT_API=8000
PORT_UI=8501
