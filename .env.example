# ─── Google Gemini (LLM) ─────────────────────────────────────────────────────
# Note: GEMINI_API_KEY is NOT required on server — users provide their own keys (BYOK) in the UI.
# Optional server fallback:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/genai_chat

# ─── Server ──────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─── Agent Config ────────────────────────────────────────────────────────────
MAX_CONTEXT_MESSAGES=25
DAILY_MESSAGE_LIMIT=50

# ─── Auth / Google OAuth & Super Admin ───────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-random-string
JWT_EXPIRY_HOURS=24
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Super Admin emails (comma-separated). Admins can upload shared demo documents.
ADMIN_EMAILS=boobesh2509@gmail.com

# Storage Quota in MB per regular user (0 = unlimited for local use, 50 for cloud deploy)
USER_STORAGE_QUOTA_MB=0


# ─── Qdrant (Vector Store) ───────────────────────────────────────────────────
# For local Docker / bare metal:
QDRANT_HOST=localhost
QDRANT_PORT=6333
# For Qdrant Cloud (Managed Free Tier):
QDRANT_URL=
QDRANT_API_KEY=

# ─── Redis (Caching) ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Embedding Model ─────────────────────────────────────────────────────────
EMBEDDING_MODEL=models/gemini-embedding-001

# ─── LangSmith (Tracing - Optional) ─────────────────────────────────────────
# Tracing is optional. If LANGCHAIN_API_KEY is unset, tracing automatically defaults to false.
# Free signup: https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=genai_project
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

